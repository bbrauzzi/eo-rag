# Copy this to infra/env.sh (gitignored - it holds a secret) and fill in your own
# values, then `source infra/env.sh` once per shell session before running
# ./infra/deploy.sh or ./infra/undeploy.sh.

# Most setups: just the profile name, leave the eval line below alone (it no-ops
# harmlessly if `aws configure export-credentials` isn't relevant to you).
#
# If your `aws` CLI resolves credentials through something Terraform's Go-based AWS
# provider can't use directly (SSO via a custom broker, an internal login tool, etc -
# the symptom is `terraform apply` failing with "No valid credential sources found"
# even though `aws sts get-caller-identity` works fine), leave TF_VAR_aws_profile empty
# and rely on the eval line: it flattens whatever the CLI resolves into plain
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/AWS_SESSION_TOKEN, which every AWS SDK
# understands - and re-running it (just `source infra/env.sh` again) refreshes expired
# temporary credentials with no other change needed.
export TF_VAR_aws_profile=<your-aws-cli-profile-or-leave-empty>
eval "$(aws configure export-credentials --format env 2>/dev/null)" || true
export TF_VAR_aws_region=us-east-1
export TF_VAR_anthropic_api_key=sk-ant-...

# One-time output of infra/persistent, see README's "One-time setup":
#   terraform -chdir=infra/persistent output -raw ecr_repository_url
export TF_VAR_ecr_repository_url=<account-id>.dkr.ecr.us-east-1.amazonaws.com/eo-rag

# The tag you built and pushed once (README). Reused every cycle - only rebuild and
# push a new tag (or retag :demo) after you actually change the code.
export TF_VAR_image_tag=demo

# Pin once by checking what's actually supported in your region:
#   aws rds describe-db-engine-versions --engine postgres \
#     --query "DBEngineVersions[?starts_with(EngineVersion,'16.')].EngineVersion"
export TF_VAR_db_engine_version=<e.g. 16.4>
