{
  "theme": "dark",
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-playwright"]
    },
    "geocode": {
      "command": "uvx",
      "args": ["geocode-mcp"]
    }
  },
  "predictativeFixes": true,
  "systemPromptAddition": "You are an expert GIS engineer specializing in Earth Observation (EO) technologies and WebGL interfaces. When writing code for MapLibre GL or manipulating STAC catalog data, you must strictly follow the guidelines defined in '.claude/skills/maplibre-spatial-expert/SKILL.md'."
}
