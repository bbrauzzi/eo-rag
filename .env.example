# Database (default consistent with docker-compose.yml)
DATABASE_URL=postgresql+psycopg://eorag:eorag@db:5432/eorag

# LLM
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# Embeddings (Amazon Bedrock - Titan Text Embeddings V2)
# Requires model access enabled in the chosen region (Bedrock console > Model access)
AWS_REGION=us-east-1
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
EMBEDDING_DIM=1024

# AWS credentials: omit them if you use an AWS profile (~/.aws/credentials) or an instance role
#AWS_ACCESS_KEY_ID=AKIA...
#AWS_SECRET_ACCESS_KEY=...

# STAC
STAC_API_URL=https://earth-search.aws.element84.com/v1

# Guardrails
# The step cap bounds one turn; the two below bound a whole conversation, keyed on its
# conversation_id. Either at 0 turns that check off.
MAX_AGENT_STEPS=5
MAX_CONVERSATION_TURNS=20
MAX_CONVERSATION_COST_USD=1.00

# Per-client rate limiting. The budget above is keyed on a conversation id the client
# chooses, so a caller sending a new one every request is bounded by nothing; this is
# keyed on the caller. Two tiers: /ask spends money on a model, the proxies spend
# bandwidth. /health and the static UI are not limited at all.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ASK_PER_MINUTE=10
RATE_LIMIT_PROXY_PER_MINUTE=120

# Turn on ONLY when a proxy you control terminates the connection: a header the client
# sets is a header the client can forge, and trusting it with nothing in front lets
# anyone bypass the limiter by varying X-Forwarded-For per request.
RATE_LIMIT_TRUST_PROXY_HEADER=false
RATE_LIMIT_MAX_TRACKED_CLIENTS=10000

# Observability. Tracing itself needs no configuration and cannot be turned off: every
# turn writes one JSON line per event to the `eo_rag.trace` logger, which is what
# `docker compose logs api | grep eo_rag.trace` reads.
#
# Langfuse is an exporter on top of that, and needs BOTH keys plus the optional extra:
#   uv sync --extra observability
# Half-filled keys are the usual way to think tracing is exported when it is not.
LANGFUSE_ENABLED=true
#LANGFUSE_PUBLIC_KEY=pk-lf-...
#LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# MCP. The stdio transport needs none of this - it is a subprocess an MCP client launches,
# and `eo-rag-mcp` is the whole configuration. These govern only the HTTP transport that
# `app/main.py` mounts at /mcp, which needs the optional extra:
#   uv sync --extra mcp
MCP_HTTP_ENABLED=true

# DNS-rebinding protection. The SDK validates the Host header and its default allowlist is
# `127.0.0.1:*`, `localhost:*`, `[::1]:*` - note those patterns **require a port**, so a
# request arriving on 80 or 443, where clients omit it, is refused even from localhost.
# Behind any real hostname or reverse proxy this must be set, and the symptom when it is
# not is `421 Invalid Host header`, which reads as a broken server rather than a policy.
# Empty means "keep the safe default" rather than "allow nothing". These are list[str]
# fields (app/config.py) - pydantic-settings decodes a plain env var for a list field as
# JSON, so it's a JSON array, not a bare or comma-separated string (confirmed live: the
# latter crashes Settings() at import with json.decoder.JSONDecodeError, which takes the
# whole container down before uvicorn ever starts, not just /mcp).
#MCP_ALLOWED_HOSTS=["mcp.example.com","mcp.example.com:8000"]
#MCP_ALLOWED_ORIGINS=["https://app.example.com"]

# Its own rate-limit tier, because one MCP session is many requests that are not tool
# calls: measured, a handshake plus three listings is 8 HTTP requests, so /ask's 10/min
# would refuse the second client to connect.
RATE_LIMIT_MCP_PER_MINUTE=60
